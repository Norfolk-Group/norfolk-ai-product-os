{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norfolk.ai/schemas/reference-evidence.schema.json",
  "type": "object",
  "required": ["name", "state", "observedAt", "source", "owner"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "state": { "enum": ["named", "observed", "extracted", "accepted", "rejected", "superseded"] },
    "observedAt": { "type": "string", "format": "date" },
    "source": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "extractedRules": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
