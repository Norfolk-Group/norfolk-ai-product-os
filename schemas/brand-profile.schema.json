{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norfolk.ai/schemas/brand-profile.schema.json",
  "title": "Brand profile",
  "type": "object",
  "required": ["id", "modes", "incompleteClientBrand", "foundationProtected", "norfolkMaster", "productIdentity", "endorsement", "appearance"],
  "properties": {
    "id": { "$ref": "#/definitions/string" },
    "modes": { "type": "array", "uniqueItems": true, "allOf": [{ "contains": { "const": "norfolk-master" } }, { "contains": { "const": "client-master" } }], "items": { "enum": ["norfolk-master", "client-master"] } },
    "incompleteClientBrand": { "const": "derived-client-system" },
    "foundationProtected": { "const": true },
    "norfolkMaster": {
      "type": "object", "required": ["name", "visualAuthority", "interimVisuals"], "additionalProperties": false,
      "properties": { "name": { "const": "Norfolk AI" }, "visualAuthority": { "const": "Claude Design" }, "interimVisuals": { "const": "neutral-semantic-placeholders" } }
    },
    "productIdentity": {
      "type": "object", "required": ["scope", "globalAcrossInstances", "configuredBy", "organizationOverride"], "additionalProperties": false,
      "properties": { "scope": { "const": "product" }, "globalAcrossInstances": { "const": true }, "configuredBy": { "const": "super-admin" }, "organizationOverride": { "const": false } }
    },
    "endorsement": {
      "type": "object", "required": ["text", "url", "required", "removable", "newTab", "surfaces"], "additionalProperties": false,
      "properties": {
        "text": { "const": "Powered by Norfolk AI" }, "url": { "const": "https://www.norfolk.ai" }, "required": { "const": true }, "removable": { "const": false }, "newTab": { "const": true },
        "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/string" } }
      }
    },
    "appearance": {
      "type": "object", "required": ["variants", "firstVisit", "persistSelection"], "additionalProperties": false,
      "properties": { "variants": { "type": "array", "uniqueItems": true, "allOf": [{ "contains": { "const": "light" } }, { "contains": { "const": "dark" } }], "items": { "enum": ["light", "dark"] } }, "firstVisit": { "const": "system" }, "persistSelection": { "const": true } }
    }
  },
  "additionalProperties": false,
  "definitions": { "string": { "type": "string", "minLength": 1 } }
}
