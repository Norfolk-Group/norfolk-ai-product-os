{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norfolk.ai/schemas/output-contract.schema.json",
  "type": "object",
  "required": ["id", "format", "audience", "purpose", "dataAuthority", "overflow", "accessibility", "validation"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "format": { "enum": ["pdf", "xlsx", "pptx", "docx", "email", "chart", "print"] },
    "audience": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "dataAuthority": { "type": "string", "minLength": 1 },
    "overflow": { "type": "string", "minLength": 1 },
    "accessibility": { "type": "string", "minLength": 1 },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
