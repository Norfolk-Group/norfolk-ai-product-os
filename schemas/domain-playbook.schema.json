{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norfolk.ai/schemas/domain-playbook.schema.json",
  "title": "Domain playbook",
  "type": "object",
  "required": ["id", "domain", "status", "owner", "lastVerified", "claims"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "evidence-review", "accepted", "deprecated", "superseded"] },
    "owner": { "type": "string", "minLength": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scope", "statement", "evidenceRefs", "evidenceStrength", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["universal", "domain", "product-pattern"] },
          "statement": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidenceStrength": { "enum": ["none", "single-example", "multi-product", "research", "authoritative"] },
          "confidence": { "enum": ["low", "medium", "high"] }
        },
        "allOf": [
          {
            "if": { "properties": { "scope": { "const": "universal" } } },
            "then": { "properties": { "evidenceStrength": { "enum": ["multi-product", "research", "authoritative"] } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["reviewer", "decision", "reviewedAt"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["accepted", "rejected", "deferred"] },
        "reviewedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": {
        "required": ["review"],
        "properties": {
          "claims": {
            "minItems": 1,
            "items": { "properties": { "evidenceRefs": { "minItems": 1 } } }
          },
          "review": { "properties": { "decision": { "const": "accepted" } } }
        }
      }
    }
  ],
  "additionalProperties": false
}
