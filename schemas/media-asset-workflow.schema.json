{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norfolk.ai/schemas/media-asset-workflow.schema.json",
  "title": "Media asset workflow",
  "type": "object",
  "required": ["id", "libraries", "superAdminCapabilities", "generation", "logos", "portraits", "propertyImages", "externalProvider", "sharing", "deletion"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "libraries": { "type": "object", "required": ["platformPrivate", "organizationIsolated", "crossOrganizationLeakage", "selectivePlatformSharing"], "additionalProperties": false, "properties": { "platformPrivate": { "const": true }, "organizationIsolated": { "const": true }, "crossOrganizationLeakage": { "const": false }, "selectivePlatformSharing": { "type": "boolean" } } },
    "superAdminCapabilities": { "type": "array", "uniqueItems": true, "allOf": [{ "contains": { "const": "create" } }, { "contains": { "const": "read" } }, { "contains": { "const": "update" } }, { "contains": { "const": "delete" } }], "items": { "enum": ["create", "read", "update", "delete", "restore", "approve", "share", "purge"] } },
    "generation": { "type": "object", "required": ["originalPreserved", "candidateCount", "regenerationAllowed", "historyPreserved", "explicitSelection"], "additionalProperties": false, "properties": { "originalPreserved": { "const": true }, "candidateCount": { "const": 3 }, "regenerationAllowed": { "const": true }, "historyPreserved": { "const": true }, "explicitSelection": { "const": true } } },
    "logos": { "type": "object", "required": ["preserveRecognizableMark", "allowedProcessing", "recolorOrRedrawRequiresApproval"], "additionalProperties": false, "properties": { "preserveRecognizableMark": { "const": true }, "allowedProcessing": { "$ref": "#/definitions/stringList" }, "recolorOrRedrawRequiresApproval": { "const": true } } },
    "portraits": { "type": "object", "required": ["identityFidelity", "modelTrainingAllowed", "explicitSelectionRequired", "manualEditingAllowed", "initialsFallback", "singleProductBackgroundStandard", "generationRoundsDefault", "additionalRoundsBy"], "additionalProperties": false, "properties": { "identityFidelity": { "const": true }, "modelTrainingAllowed": { "const": false }, "explicitSelectionRequired": { "const": true }, "manualEditingAllowed": { "const": false }, "initialsFallback": { "const": "first-last-or-first-two" }, "singleProductBackgroundStandard": { "const": true }, "generationRoundsDefault": { "type": "integer", "minimum": 1 }, "additionalRoundsBy": { "const": "super-admin" } } },
    "propertyImages": { "type": "object", "required": ["factualChangesAllowed", "allowedProcessing", "disclosure", "originalTraceable"], "additionalProperties": false, "properties": { "factualChangesAllowed": { "const": false }, "allowedProcessing": { "$ref": "#/definitions/stringList" }, "disclosure": { "const": "metadata-and-report-not-render-overlay" }, "originalTraceable": { "const": true } } },
    "externalProvider": { "type": "object", "required": ["noTraining", "minimalRetention", "encryptedTransfer", "verifiedDeletion", "sensitiveLogging", "failClosed"], "additionalProperties": false, "properties": { "noTraining": { "const": true }, "minimalRetention": { "const": true }, "encryptedTransfer": { "const": true }, "verifiedDeletion": { "const": true }, "sensitiveLogging": { "const": false }, "failClosed": { "const": true } } },
    "sharing": { "type": "object", "required": ["privateByDefault", "approval", "recipientSpecific", "revocable", "reshareAllowed"], "additionalProperties": false, "properties": { "privateByDefault": { "const": true }, "approval": { "const": "super-admin" }, "recipientSpecific": { "const": true }, "revocable": { "const": true }, "reshareAllowed": { "const": false } } },
    "deletion": { "type": "object", "required": ["recoverable", "referenceAware", "finalPurgeBy", "imageRemovedFromAudit", "nonImageAuditEventRetained"], "additionalProperties": false, "properties": { "recoverable": { "const": true }, "referenceAware": { "const": true }, "finalPurgeBy": { "const": "super-admin" }, "imageRemovedFromAudit": { "const": true }, "nonImageAuditEventRetained": { "const": true } } }
  },
  "additionalProperties": false,
  "definitions": { "stringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
}
