{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norfolk.ai/schemas/capability-map.schema.json",
  "type": "object",
  "required": ["capabilities"],
  "properties": {
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "userVocabulary", "procedure", "callers", "contextAvailability", "completionSignal", "recovery", "consequential", "transports"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "userVocabulary": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "procedure": { "type": "string", "minLength": 1 },
          "callers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "contextAvailability": { "type": "string", "minLength": 1 },
          "completionSignal": { "type": "string", "minLength": 1 },
          "recovery": { "type": "string", "minLength": 1 },
          "consequential": { "type": "boolean" },
          "transports": {
            "type": "array",
            "minItems": 7,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["name", "applicability", "procedure", "authorizationPolicy", "approvalPolicy"],
                  "properties": {
                    "name": { "enum": ["ui", "trpc", "mcp", "copilot", "jobs", "reports", "schedules"] },
                    "applicability": { "const": "implemented" },
                    "procedure": { "type": "string", "minLength": 1 },
                    "authorizationPolicy": { "type": "string", "minLength": 1 },
                    "approvalPolicy": { "enum": ["none", "human-only"] }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["name", "applicability", "exception"],
                  "properties": {
                    "name": { "enum": ["ui", "trpc", "mcp", "copilot", "jobs", "reports", "schedules"] },
                    "applicability": { "const": "not-applicable" },
                    "exception": {
                      "type": "object",
                      "required": ["reasonType", "reason", "humanProcedure", "approvalId"],
                      "properties": {
                        "reasonType": { "enum": ["physical", "legal", "security"] },
                        "reason": { "type": "string", "minLength": 1 },
                        "humanProcedure": { "type": "string", "minLength": 1 },
                        "approvalId": { "type": "string", "minLength": 1 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
