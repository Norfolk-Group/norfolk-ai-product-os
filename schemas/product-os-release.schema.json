{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norfolk.ai/schemas/product-os-release.schema.json",
  "type": "object",
  "required": ["version", "status", "sourceCommit", "manifestSha256", "standards", "createdAt", "visibility"],
  "properties": {
    "version": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "status": { "enum": ["candidate", "released", "deprecated", "unsupported"] },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "standards": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "visibility": { "const": "private" },
    "signedBy": { "type": "string", "minLength": 1 },
    "minimumKitVersion": { "type": "string" }
  },
  "additionalProperties": false
}
